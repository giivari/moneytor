{
  "$comment": "Token discipline: raw colors, font sizes, radii, shadows, !important and :root live only in src/app/tokens.css. Files in ignoreFiles are not migrated yet; remove each one from the list when its page is migrated.",
  "ignoreFiles": [
    "references/**",
    "node_modules/**",
    ".next/**",
    "src/app/auth.css",
    "src/app/automation.css",
    "src/app/interaction.css",
    "src/app/onboarding.css",
    "src/app/responsive.css",
    "src/app/settings.css",
    "src/app/typography.css",
    "src/app/visual.css",
    "src/app/insights/insights.css"
  ],
  "rules": {
    "color-no-hex": true,
    "color-named": "never",
    "function-disallowed-list": [
      "rgb",
      "rgba",
      "hsl",
      "hsla",
      "hwb",
      "lab",
      "lch",
      "oklab",
      "oklch"
    ],
    "declaration-no-important": true,
    "selector-disallowed-list": [
      "/:root/"
    ],
    "declaration-property-value-allowed-list": {
      "font-size": [
        "/^var\\(--(text|type)-[a-z0-9-]+\\)$/",
        "inherit",
        "100%",
        "1em"
      ],
      "border-radius": [
        "/^(var\\(--radius-(sm|md|lg|pill)\\)|0|50%|inherit)( (var\\(--radius-(sm|md|lg|pill)\\)|0))*$/"
      ],
      "box-shadow": [
        "/^var\\(--shadow-[1-3]\\)$/",
        "none",
        "/^inset 0 0 0 1px var\\(--[a-z-]+\\)$/"
      ],
      "font-weight": [
        "/^var\\(--weight-[a-z]+\\)$/",
        "inherit"
      ],
      "line-height": [
        "/^var\\(--leading-[a-z]+\\)$/",
        "1",
        "inherit",
        "/^[0-9.]+$/"
      ],
      "font-family": [
        "inherit",
        "/^var\\(--font-[a-z]+\\)/"
      ]
    },
    "media-feature-name-value-allowed-list": {
      "max-width": [
        "390px",
        "767px",
        "1023px",
        "1279px"
      ],
      "min-width": [
        "768px",
        "1024px",
        "1280px"
      ]
    },
    "declaration-block-no-duplicate-properties": [
      true,
      {
        "ignore": [
          "consecutive-duplicates-with-different-values"
        ]
      }
    ],
    "no-duplicate-selectors": true,
    "property-disallowed-list": [
      "user-select"
    ]
  },
  "overrides": [
    {
      "files": [
        "src/app/tokens.css"
      ],
      "rules": {
        "color-no-hex": null,
        "function-disallowed-list": null,
        "selector-disallowed-list": null,
        "declaration-property-value-allowed-list": null
      }
    }
  ]
}
