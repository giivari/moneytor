# Server-only PostgreSQL connection string. Supply a private value locally.
DATABASE_URL=

# Optional PostgreSQL pool & TLS tuning for free-tier serverless deployments (e.g., Neon, Supabase, Render).
# MONETA_DB_POOL_MAX=3
# MONETA_DB_SSL=require

# Server-only. Local development only; production requires an exact HTTPS origin.
MONETA_ORIGIN=http://localhost:3000
MONETA_RP_ID=localhost
# Generate 32 random bytes encoded as base64url (43 characters). Remove after enrollment.
MONETA_BOOTSTRAP_SECRET=

# Optional P4.1 market quote provider (composite, coingecko, twelvedata, alphavantage, http-json).
# MONETA_PRICE_PROVIDER=composite
# MONETA_PRICE_DEFAULT_ADAPTER=
# MONETA_COINGECKO_API_KEY=
# MONETA_TWELVEDATA_API_KEY=
# MONETA_ALPHAVANTAGE_API_KEY=
# MONETA_PRICE_PROVIDER_URL=
# MONETA_PRICE_PROVIDER_TOKEN=
