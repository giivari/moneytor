{
  "regions": ["sin1"],
  "headers": [
    {
      "source": "/brands/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }]
    },
    {
      "source": "/icon-(.*).png",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }]
    }
  ],
  "crons": [
    {
      "path": "/api/cron/refresh-prices",
      "schedule": "0 0 * * *"
    }
  ]
}
